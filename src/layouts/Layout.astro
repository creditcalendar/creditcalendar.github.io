---
import '../styles/site.css';
import NavigationGlass from '../components/NavigationGlass.astro';
interface Props { title: string; description?: string; article?: boolean; }
const { title, description = 'Discover deals, keep track of important dates, and organize your credit cards with Credit Calendar for iPhone and iPad.', article = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const navigation = [['/', 'Overview'], ['/feed/', 'Feed'], ['/contact/', 'Contact Us'], ['/developer/', 'Developer']];
const isCurrent = (path: string) => path === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(path);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F6F2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/assets/images/social-icon.png', Astro.site)} />
    <link rel="icon" type="image/x-icon" href="/assets/img/favicons/favicon.ico?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-light-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicons/favicon-light-16.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-light-32.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicons/favicon-dark-16.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-dark-32.png" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/assets/img/favicons/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Credit Calendar updates" href="/feed.xml" />
  </head>
  <body>
    <NavigationGlass />
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <div class="navigation">
        <a class="brand" href="/"><picture class="app-icon"><source srcset="/assets/images/brand-dark.png" media="(prefers-color-scheme: dark)" /><img src="/assets/images/brand-light.png" width="21" height="21" alt="" /></picture>Credit Calendar</a>
        <nav aria-label="Main navigation">
          {navigation.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <a class="nav-download" href="https://apps.apple.com/app/id1254202950">Get the app</a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <div><a class="brand" href="/">Credit Calendar</a><p>Read Doctor of Credit on iPhone and iPad.</p></div>
      <div class="footer-links"><a href="/feed/">Feed</a><a href="/search/">Search</a><a href="/contact/">Contact Us</a><a href="/developer/">Developer</a><a href="/feed.xml">RSS</a></div>
      <p class="disclaimer">Credit Calendar is an independent, unofficial app. It is not affiliated with or endorsed by Doctor of Credit.</p>
      <p class="copyright">© {new Date().getFullYear()} Credit Calendar, Ching-Lan (Alan) Chen</p>
    </footer>
  </body>
</html>
