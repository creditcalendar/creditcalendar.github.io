---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { publishedPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await publishedPosts();
  return (['tags', 'categories'] as const).flatMap((taxonomy) =>
    [...new Set(posts.flatMap((post) => post.data[taxonomy]))].map((name) => ({
      params: { taxonomy, name },
      props: { name, posts: posts.filter((post) => post.data[taxonomy].includes(name)) },
    })),
  );
}
const { name, posts } = Astro.props;
---
<Layout title={`${name} — Credit Calendar`}><section class="inner section">
  <p class="eyebrow">BROWSE UPDATES</p><h1>{name}</h1><PostList posts={posts} />
  <a class="text-link" href={`/${Astro.params.taxonomy}/`}>Browse all {Astro.params.taxonomy}</a>
</section></Layout>
