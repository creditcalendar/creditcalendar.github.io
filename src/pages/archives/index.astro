---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { publishedPosts } from '../../lib/posts';
const posts = await publishedPosts();
const years = [...new Set(posts.map((post) => post.data.date.getUTCFullYear()))];
---
<Layout title="Archives — Credit Calendar"><section class="inner section">
  <p class="eyebrow">THROUGH THE YEARS</p><h1>Archives</h1>
  {years.length ? years.map((year) => <section><h2>{year}</h2><PostList posts={posts.filter((post) => post.data.date.getUTCFullYear() === year)} /></section>) : <PostList posts={[]} />}
  <a class="text-link" href="/feed/">All updates</a>
</section></Layout>
