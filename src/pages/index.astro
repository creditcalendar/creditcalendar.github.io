---
import Layout from '../layouts/Layout.astro';
import HeroScene from '../components/HeroScene.astro';
import AppIcon from '../components/AppIcon.astro';
import AppPreview from '../components/AppPreview.astro';
---
<Layout title="Doctor of Credit for iPhone & iPad — Credit Calendar">

<section class="hero"><h1>Read Doctor of Credit.<br>On your iPhone.</h1><p class="intro">Read the posts, save offers, and keep deal dates in view.</p><div class="actions"><a class="button primary" href="https://apps.apple.com/app/id1254202950"><svg aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M16.6 12.8c0-2 1.6-3 1.7-3.1-1-1.5-2.5-1.7-3.1-1.7-1.3-.1-2.5.8-3.2.8-.6 0-1.6-.8-2.7-.8-1.4 0-2.7.8-3.4 2-1.5 2.5-.4 6.3 1 8.4.7 1 1.5 2 2.6 1.9 1-.1 1.4-.6 2.7-.6 1.2 0 1.6.6 2.7.6 1.1 0 1.8-1 2.5-2 .8-1.1 1.1-2.2 1.1-2.3-.1 0-1.9-.7-1.9-3.2ZM14.5 6.6c.6-.8 1.1-1.8 1-2.9-.9 0-2 .6-2.7 1.4-.6.7-1.1 1.8-1 2.8 1 .1 2-.5 2.7-1.3Z"/></svg>Download on the App Store</a><a class="button secondary" href="#features">Explore the app</a></div><p class="availability">An independent reader for iPhone and iPad</p>
<div class="showcase" aria-label="Credit Calendar app preview">
  <HeroScene />
  <AppPreview />
</div><p class="preview-caption">A preview of the Credit Calendar experience.</p></section>


<section class="features section" id="features"><div class="section-heading"><h2>Read. Find. Keep track.</h2><p>Browse the feed, then use these tools to follow up on an offer.</p></div><div class="feature-grid">
<article class="feature"><h3>Search Doctor of Credit</h3><p>Search Doctor of Credit articles or browse categories to find the offers that matter to you.</p></article>
<article class="feature"><h3>See deal dates</h3><p>See deal dates on a monthly calendar and explore the offers listed for each day.</p></article>
<article class="feature"><h3>Compare ways to pay</h3><p>Search for a store or product. Let AI help you compare offers and payment options.</p></article>
<article class="feature"><h3>Keep your bookmarks and cards</h3><p>Access your bookmarks, cards, and settings in one place. Manage iCloud sync and notification preferences.</p></article>
</div></section>


<section class="closing section"><AppIcon size={72} alt="Credit Calendar app icon" /><h2>Credit Calendar for iPhone and iPad</h2><a class="button primary" href="https://apps.apple.com/app/id1254202950">Get Credit Calendar</a><p>Have a question? <a href="/contact/">Contact support.</a></p></section>

</Layout>
