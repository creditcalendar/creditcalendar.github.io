---
import Layout from '../layouts/Layout.astro';
import HeroScene from '../components/HeroScene.astro';
import AppIcon from '../components/AppIcon.astro';
import AppPreview from '../components/AppPreview.astro';
import '../styles/home.css';
const days = Array.from({length: 30}, (_, i) => i + 1);
const marked = [7, 12, 18, 24, 27];
---
<Layout title="Doctor of Credit for iPhone & iPad — Credit Calendar">
  <div class="home">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <h1 id="home-title">Read the deals.<br />Keep the dates.</h1>
        <p class="intro">Read Doctor of Credit and track offers on iPhone and iPad.</p>
        <div class="actions"><a class="button primary" href="https://apps.apple.com/app/id1254202950">Download on the App Store </a><a class="hero-explore" href="#features">Explore the app </a></div>
        <div class="hero-index"><a href="#reader"><span>01</span> Read the feed</a><a href="#calendar"><span>02</span> Follow the dates</a><a href="#features"><span>03</span> Keep an offer</a></div>
      </div>
      <div class="phone-stage">
        <div class="phone-display">
          <HeroScene variant="phone" />
          <div class="phone-wrap"><AppPreview /></div>
        </div>
      </div>
    </section>

    <section class="reader-strip home-section" id="reader"><h2>Doctor of Credit,<br />where you read.</h2><p>Credit Calendar is an independent reader. Browse posts by category, search for an offer, or return to a saved article.</p><a class="text-link" href="/feed/">Visit the website feed </a></section>

    <section class="calendar-section home-section" id="calendar">
      <div class="calendar-intro"><h2>See when<br />offers end.</h2><p>Browse offers by date in the Deal Calendar.</p><p class="demo-instruction">Try a marked date </p></div>
      <div class="calendar-instrument">
        <div class="calendar-visual"><HeroScene /><div class="calendar-heading"><h3>November <span>2026</span></h3><span class="section-label">Sample month</span></div>
        <div class="calendar-week" aria-hidden="true">{['S','M','T','W','T','F','S'].map(day => <span>{day}</span>)}</div>
        <div class="calendar-days" role="group" aria-label="Sample November 2026 deal dates">{days.map(day => marked.includes(day) ? <button type="button" data-day={day} aria-label={`November ${day}, sample deals`} aria-pressed={day === 7}><span>{day}</span><i aria-hidden="true"></i></button> : <span class="quiet-day">{day}</span>)}</div>
        </div>
        <div class="deal-detail" aria-live="polite" aria-atomic="true"><div class="deal-date"><span class="section-label">Selected date</span><strong id="selected-date">Nov 07</strong></div><div><h3 id="selected-deal">Explore a checking account bonus</h3><p id="selected-description">Review the offer and its qualifying requirements.</p></div></div>
        <p class="sample-note">Interactive preview. Sample offers, not current promotions.</p>
      </div>
    </section>

    <section class="home-section tools-section" id="features"><div><h2>From finding<br />to saving.</h2></div><div class="tool-rows">
      <article><div><h3>Search Doctor of Credit</h3><p>Search articles or browse categories to find the offers that matter to you.</p></div></article>
      <article><div><h3>Compare ways to pay</h3><p>Search for a store or product. Let AI help you compare offers and payment options.</p></div></article>
      <article><div><h3>Keep bookmarks and cards</h3><p>Access your bookmarks, cards, and settings in one place. Manage iCloud sync and notification preferences.</p></div></article>
    </div></section>
    <section class="home-section home-closing"><AppIcon size={72} alt="Credit Calendar app icon" /><div><h2>Get Credit Calendar</h2><p>Have a question? <a href="/contact/">Contact support.</a></p></div><a class="button primary" href="https://apps.apple.com/app/id1254202950">Download on the App Store</a></section>
  </div>
</Layout>
<script>
  const samples: Record<string, [string, string]> = {
    '7': ['Explore a checking account bonus', 'Review the offer and its qualifying requirements.'],
    '12': ['Activate an eligible rewards offer', 'Check the activation steps before making a purchase.'],
    '18': ['Take a closer look at a gift card offer', 'Read the terms and check which retailers qualify.'],
    '24': ['Compare payment options for an order', 'Review the available offers before you check out.'],
    '27': ['Revisit an offer before it ends', 'Check the deadline and any remaining requirements.'],
  };
  document.querySelectorAll<HTMLButtonElement>('[data-day]').forEach(button => {
    button.addEventListener('click', () => {
      const day = button.dataset.day!;
      document.querySelectorAll('[data-day]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      document.getElementById('selected-date')!.textContent = `Nov ${day.padStart(2, '0')}`;
      document.getElementById('selected-deal')!.textContent = samples[day][0];
      document.getElementById('selected-description')!.textContent = samples[day][1];
    });
  });
</script>
