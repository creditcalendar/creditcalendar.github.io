---
import Layout from '../layouts/Layout.astro';
import HeroScene from '../components/HeroScene.astro';
import AppIcon from '../components/AppIcon.astro';
import AppPreview from '../components/AppPreview.astro';
import '../styles/home.css';
const dealSource = 'https://www.doctorofcredit.com/deal-calendar-full-list-deals-credit-card-bank-bonuses-expiry-dates/';
---
<Layout title="Doctor of Credit for iPhone & iPad — Credit Calendar">
  <div class="home">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <h1 id="home-title">Read the deals.<br />Keep the dates.</h1>
        <p class="intro">Read Doctor of Credit and track offers on iPhone and iPad.</p>
        <div class="actions"><a class="button primary" href="https://apps.apple.com/app/id1254202950">Download on the App Store </a><a class="hero-explore" href="#features">Explore the app </a></div>
        <div class="hero-index"><a href="#reader"><span>01</span> Read the feed</a><a href="#calendar"><span>02</span> Follow the dates</a><a href="#features"><span>03</span> Keep an offer</a></div>
      </div>
      <div class="phone-stage">
        <div class="phone-display">
          <HeroScene variant="phone" />
          <div class="phone-wrap"><AppPreview /></div>
        </div>
      </div>
    </section>

    <section class="reader-strip home-section" id="reader"><h2>Doctor of Credit,<br />where you read.</h2><p>Credit Calendar is an independent reader. Browse posts by category, search for an offer, or return to a saved article.</p><a class="text-link" href="/feed/">Visit the website feed </a></section>

    <section class="calendar-section home-section" id="calendar">
      <div class="calendar-intro">
        <h2>See when<br />offers end.</h2>
        <p>Browse this month’s offers by listed expiration date.</p>
        <a class="text-link" href={dealSource}>Doctor of Credit Deal Calendar</a>
      </div>
      <deal-calendar class="calendar-instrument">
        <div class="calendar-visual">
          <div class="calendar-heading">
            <h3>Deal Calendar</h3>
            <button type="button" class="calendar-today" data-today>Today</button>
          </div>
          <p class="calendar-month" data-month></p>
          <div class="calendar-week" aria-hidden="true">{['S', 'M', 'T', 'W', 'T', 'F', 'S'].map(day => <span>{day}</span>)}</div>
          <div class="calendar-days" role="group" aria-label="Deal Calendar dates"></div>
        </div>
        <div class="deal-detail" aria-live="polite" aria-atomic="true">
          <strong class="calendar-selection" data-selected-date></strong>
          <div data-offers>Loading offers…</div>
        </div>
        <noscript><p>Open the Doctor of Credit Deal Calendar to see offers.</p></noscript>
      </deal-calendar>
    </section>

    <section class="home-section tools-section" id="features"><div><h2>From finding<br />to saving.</h2></div><div class="tool-rows">
      <article><div><h3>Search Doctor of Credit</h3><p>Search articles or browse categories to find the offers that matter to you.</p></div></article>
      <article><div><h3>Compare ways to pay</h3><p>Search for a store or product. Let AI help you compare offers and payment options.</p></div></article>
      <article><div><h3>Keep bookmarks and cards</h3><p>Access your bookmarks, cards, and settings in one place. Manage iCloud sync and notification preferences.</p></div></article>
    </div></section>
    <section class="home-section home-closing"><AppIcon size={72} alt="Credit Calendar app icon" /><div><h2>Get Credit Calendar</h2><p>Have a question? <a href="/contact/">Contact support.</a></p></div><a class="button primary" href="https://apps.apple.com/app/id1254202950">Download on the App Store</a></section>
  </div>
</Layout>
<script>
  type Offer = { title: string; url: string };
  type OffersByDate = Record<string, Offer[]>;

  const sourceOrigin = 'https://www.doctorofcredit.com';
  const calendarAPI = new URL('/wp-json/wp/v2/posts', sourceOrigin);
  calendarAPI.search = new URLSearchParams({
    slug: 'deal-calendar-full-list-deals-credit-card-bank-bonuses-expiry-dates',
    _fields: 'content',
  }).toString();

  const monthNames = Array.from({ length: 12 }, (_, month) =>
    new Date(2000, month, 1).toLocaleDateString('en-US', { month: 'long' }),
  );
  const dateKey = (year: number, month: number, day: number) =>
    [year, month + 1, day].map(part => String(part).padStart(2, '0')).join('-');

  function parseOffers(html: string): OffersByDate {
    // The template keeps upstream markup inert. Only link text and HTTP(S) URLs are rendered.
    const article = document.createElement('template');
    article.innerHTML = html;
    const offers: OffersByDate = {};
    let year = 0;
    let month = -1;
    let day = 0;
    for (const section of article.content.children) {
      const text = section.textContent.trim();
      if (section.tagName === 'H2') {
        const heading = /^([A-Za-z]+)\s*\((\d{4})\)$/.exec(text);
        year = heading ? Number(heading[2]) : 0;
        month = heading ? monthNames.indexOf(heading[1]) : -1;
        day = 0;
      } else if (section.tagName === 'P') {
        day = Number(/^(\d{1,2})(?:st|nd|rd|th)$/.exec(text)?.[1] ?? 0);
      } else if (section.tagName === 'UL' && year && month >= 0 && day) {
        const validDay = day <= new Date(year, month + 1, 0).getDate();
        const key = dateKey(year, month, day);
        day = 0;
        if (!validDay) continue;
        const entries = offers[key] ?? [];
        for (const link of section.querySelectorAll(':scope > li > a[href]')) {
          const href = link.getAttribute('href')!.trim();
          const title = link.textContent.replace(/\s+/g, ' ').trim();
          if (!href || !title) continue;
          let url: URL;
          try { url = new URL(href, sourceOrigin); } catch { continue; }
          if (['http:', 'https:'].includes(url.protocol) && !entries.some(offer => offer.url === url.href)) {
            entries.push({ title, url: url.href });
          }
        }
        if (entries.length) offers[key] = entries;
      }
    }
    if (!Object.keys(offers).length) throw new Error('No dated offers found');
    return offers;
  }

  class DealCalendar extends HTMLElement {
    private deals: OffersByDate | null | undefined;
    private timer?: number;
    private controller?: AbortController;
    private currentDate = '';
    private selectedDay = 0;

    connectedCallback() {
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.querySelector('[data-today]')!.addEventListener('click', () => {
        const today = new Date();
        this.currentDate = today.toDateString();
        this.selectedDay = today.getDate();
        this.render(today);
      }, { signal });
      this.updateDate();
      this.timer = window.setInterval(() => this.updateDate(), 30_000);
      document.addEventListener('visibilitychange', () => this.updateDate(), { signal });
      void this.load(signal);
    }

    disconnectedCallback() {
      this.controller?.abort();
      window.clearInterval(this.timer);
    }

    private async load(signal: AbortSignal) {
      try {
        const response = await fetch(calendarAPI, { signal, cache: 'no-store' });
        if (!response.ok) throw new Error('Calendar data unavailable');
        const posts = await response.json();
        const html = posts[0]?.content?.rendered;
        if (typeof html !== 'string') throw new Error('Calendar article unavailable');
        if (signal.aborted) return;
        this.deals = parseOffers(html);
      } catch {
        if (signal.aborted) return;
        this.deals = null;
      }
      if (!signal.aborted) this.render(new Date());
    }

    private updateDate() {
      const today = new Date();
      const date = today.toDateString();
      if (date === this.currentDate) return;
      this.currentDate = date;
      this.selectedDay = today.getDate();
      this.render(today);
    }

    private render(today: Date) {
      const year = today.getFullYear();
      const month = today.getMonth();
      const monthLabel = today.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
      const days = this.querySelector('.calendar-days')!;
      this.querySelector('[data-month]')!.textContent = monthLabel;
      days.setAttribute('aria-label', `Deal Calendar for ${monthLabel}`);
      days.replaceChildren();

      const firstWeekday = new Date(year, month, 1).getDay();
      for (let i = 0; i < firstWeekday; i++) {
        const space = document.createElement('span');
        space.setAttribute('aria-hidden', 'true');
        days.append(space);
      }
      for (let day = 1; day <= new Date(year, month + 1, 0).getDate(); day++) {
        const button = document.createElement('button');
        const count = this.deals?.[dateKey(year, month, day)]?.length ?? 0;
        button.type = 'button';
        const number = document.createElement('span');
        number.textContent = String(day);
        button.append(number);
        button.setAttribute('aria-label', `${monthLabel}, day ${day}${count ? `, ${count} ${count === 1 ? 'offer' : 'offers'}` : ''}`);
        if (day === today.getDate()) button.setAttribute('aria-current', 'date');
        if (count) {
          const mark = document.createElement('i');
          mark.setAttribute('aria-hidden', 'true');
          mark.style.setProperty('--offer-count', String(Math.min(count, 8)));
          button.append(mark);
        }
        button.addEventListener('click', () => {
          this.selectedDay = day;
          selectDay();
        });
        days.append(button);
      }

      const selectDay = () => {
        days.querySelectorAll('button').forEach((button, index) => {
          button.setAttribute('aria-pressed', String(index + 1 === this.selectedDay));
        });
        this.querySelector('[data-selected-date]')!.textContent =
          new Date(year, month, this.selectedDay).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        const details = this.querySelector('[data-offers]')!;
        const offers = this.deals?.[dateKey(year, month, this.selectedDay)];
        if (!offers?.length) {
          details.textContent = this.deals === undefined ? 'Loading offers…' :
            this.deals === null ? 'Offers are unavailable right now.' : 'No offers are listed for this date.';
          return;
        }
        const list = document.createElement('ol');
        for (const [index, offer] of offers.entries()) {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = offer.url;
          const badge = document.createElement('span');
          badge.className = 'deal-number';
          badge.setAttribute('aria-hidden', 'true');
          badge.textContent = String(index + 1);
          const title = document.createElement('span');
          title.textContent = offer.title;
          link.append(badge, title);
          item.append(link);
          list.append(item);
        }
        details.replaceChildren(list);
      };
      selectDay();
    }
  }
  customElements.define('deal-calendar', DealCalendar);
</script>
